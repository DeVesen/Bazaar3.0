server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM_SCHEME}://${API_UPSTREAM_HOST};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_UPSTREAM_HOST};
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /health {
        proxy_pass ${API_UPSTREAM_SCHEME}://${API_UPSTREAM_HOST};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_UPSTREAM_HOST};
    }

    # Einzige Ausnahme von der Clickjacking-Sperre unten: /embed/countdown ist zum
    # Einbetten per <iframe> in fremde Seiten (z. B. Wordpress) gedacht (api/cross-cutting.md
    # Abschnitt 8, Epic_Countdown_Widget Abschnitt 4).
    location /embed/countdown {
        add_header X-Frame-Options "ALLOWALL" always;
        add_header Content-Security-Policy "frame-ancestors *" always;
        try_files $uri $uri/ /index.html;
    }

    location / {
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        try_files $uri $uri/ /index.html;
    }

    # index.html has no cache-busted filename (unlike the hashed JS/CSS bundles
    # it references) - without an explicit no-cache, a browser that already
    # visited this origin can keep serving an old index.html pointing at bundle
    # filenames a new image no longer ships, silently running stale app code
    # after every redeploy (found while debugging why a freshly-empty database
    # still showed the login page instead of bootstrap-admin - server and
    # deployment were correct, the browser was serving a cached index.html).
    location = /index.html {
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header Cache-Control "no-cache" always;
    }
}
