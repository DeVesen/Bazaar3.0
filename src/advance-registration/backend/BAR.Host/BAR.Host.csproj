<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>bar-advance-registration</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- WebApplicationFactory<Program> braucht Zugriff auf die implizite
       Program-Klasse der Top-Level-Statements. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BAR.Host.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BAR.Domain\BAR.Domain.csproj" />
    <ProjectReference Include="..\BAR.Application\BAR.Application.csproj" />
    <ProjectReference Include="..\BAR.Infrastructure\BAR.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

</Project>
