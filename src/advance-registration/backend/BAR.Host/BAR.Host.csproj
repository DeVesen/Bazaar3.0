<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>bar-advance-registration</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <!-- WebApplicationFactory<Program> braucht Zugriff auf die implizite
       Program-Klasse der Top-Level-Statements. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BAR.Host.IntegrationTests" />
  </ItemGroup>

  <!-- Host referenziert die Modul-Implementierungen NUR fuer die
       Add<Modul>Module()-DI-Erweiterung (Composition Root) - Feature-Endpoints
       rufen ausschliesslich die jeweiligen .Contracts-Interfaces auf, nie
       Domain/Application/Infrastructure eines Moduls direkt
       (dotnet-modulith-bridge). Export hat kein eigenes Contracts-Projekt
       (einziger Referenzierer ist der Host). -->
  <ItemGroup>
    <ProjectReference Include="..\BAR.SharedKernel\BAR.SharedKernel.csproj" />

    <ProjectReference Include="..\BAR.Modules.Anmeldung\BAR.Modules.Anmeldung.csproj" />
    <ProjectReference Include="..\BAR.Modules.Anmeldung.Contracts\BAR.Modules.Anmeldung.Contracts.csproj" />

    <ProjectReference Include="..\BAR.Modules.Verkaeuferverwaltung\BAR.Modules.Verkaeuferverwaltung.csproj" />
    <ProjectReference Include="..\BAR.Modules.Verkaeuferverwaltung.Contracts\BAR.Modules.Verkaeuferverwaltung.Contracts.csproj" />

    <ProjectReference Include="..\BAR.Modules.Stammdaten\BAR.Modules.Stammdaten.csproj" />
    <ProjectReference Include="..\BAR.Modules.Stammdaten.Contracts\BAR.Modules.Stammdaten.Contracts.csproj" />

    <ProjectReference Include="..\BAR.Modules.Betrieb\BAR.Modules.Betrieb.csproj" />
    <ProjectReference Include="..\BAR.Modules.Betrieb.Contracts\BAR.Modules.Betrieb.Contracts.csproj" />

    <ProjectReference Include="..\BAR.Modules.Export\BAR.Modules.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

</Project>
