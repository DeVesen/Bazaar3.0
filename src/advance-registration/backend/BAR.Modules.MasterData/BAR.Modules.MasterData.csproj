<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ein Projekt fuer Domain/Application/Infrastructure (Ordner statt eigene
       .csproj - dotnet-modulith-bridge "Default: ein Projekt + .Contracts").
       Referenziert die Contracts anderer Module nur fuer synchrone
       Cross-Modul-Abfragen (SellerManagement: Typ-Nutzung zaehlen;
       Registration: Artikel-Nutzung zaehlen; Operations: Default-Typ pruefen) - nie
       deren Domain/Application/Infrastructure direkt. -->

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BAR.SharedKernel\BAR.SharedKernel.csproj" />
    <ProjectReference Include="..\BAR.Modules.MasterData.Contracts\BAR.Modules.MasterData.Contracts.csproj" />
    <ProjectReference Include="..\BAR.Modules.Registration.Contracts\BAR.Modules.Registration.Contracts.csproj" />
    <ProjectReference Include="..\BAR.Modules.SellerManagement.Contracts\BAR.Modules.SellerManagement.Contracts.csproj" />
    <ProjectReference Include="..\BAR.Modules.Operations.Contracts\BAR.Modules.Operations.Contracts.csproj" />
  </ItemGroup>

</Project>
