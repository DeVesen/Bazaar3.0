{
  "mcpServers": {
    "dev-mcp": {
      "command": "C:/Develop/.apps/dev-mcp/Dev.Mcp.exe",
      "env": {
        "LOG_VIEWER_PORT": "51011"
      }
    },
    "browser-inspector": {
      "command": "npx",
      "args": [
        "browser-inspector-mcp"
      ]
    },
    "primeng": {
      "command": "npx",
      "args": [
        "-y",
        "@primeng/mcp"
      ]
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
